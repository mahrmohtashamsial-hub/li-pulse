{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "li-pulse",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",
  "workers_dev": true,
  "triggers": { "crons": ["*/2 * * * *"] },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "li-pulse",
      "database_id": "09eee04b-69ac-44c2-b2ef-79a5d9976bd6",
      "migrations_dir": "migrations"
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "APIFY_TOKEN",
      "store_id": "8cf6d4c81cf7408c8d30d2efa037ebdd",
      "secret_name": "APIFY_TOKEN"
    },
    {
      "binding": "APIFY_WEBHOOK_SECRET",
      "store_id": "8cf6d4c81cf7408c8d30d2efa037ebdd",
      "secret_name": "APIFY_WEBHOOK_SECRET"
    },
    {
      "binding": "TURNSTILE_SECRET",
      "store_id": "8cf6d4c81cf7408c8d30d2efa037ebdd",
      "secret_name": "li-pulse-turnstile"
    }
  ],
  "vars": {
    "MAX_PROFILES_PER_RUN": "100",
    "JOB_MAX_DURATION_MINUTES": "30"
  }
}
